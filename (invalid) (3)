        "x": gun_x + math.cos(gun_angle) * 50,
        "y": gun_y + math.sin(gun_angle) * 50,
        "dx": dx,
        "dy": dy,
    })
    current_ammo -= 1

  elif selected_gun == "AK47":
    for _ in range(2):
      s_angle = gun_angle + random.uniform(-0.03, 0.03)
      dx = speed * math.cos(s_angle)
      dy = speed * math.sin(s_angle)
      bullets.append({
          "x": gun_x + math.cos(s_angle) * 50,
          "y": gun_y + math.sin(s_angle) * 50,
          "dx": dx,
          "dy": dy,
      })
      current_ammo -= 1

  elif selected_gun in ["MACHINE_GUN", "MINIGUN", "LASER_RIFLE"]:
    s_angle = gun_angle + random.uniform(-0.05, 0.05)
    dx = speed * math.cos(s_angle)
    dy = speed * math.sin(s_angle)
    bullets.append({
        "x": gun_x + math.cos(s_angle) * 50,
        "y": gun_y + math.sin(s_angle) * 50,
        "dx": dx,
        "dy": dy,
    })
    current_ammo -= 1

  elif selected_gun == "PLASMA_CANNON":
    for offset in [-0.08, 0, 0.08]:
      s_angle = gun_angle + offset
      dx = speed * 1.2 * math.cos(s_angle)
      dy = speed * 1.2 * math.sin(s_angle)
      bullets.append({
          "x": gun_x + math.cos(s_angle) * 50,
          "y": gun_y + math.sin(s_angle) * 50,
          "dx": dx,
          "dy": dy,
      })
