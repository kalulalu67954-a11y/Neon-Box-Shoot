def generate_gunshot_sound():
  if not HAS_NUMPY:
    return None
  try:
    duration = 0.2
    sample_rate = 44100
    t = np.linspace(0, duration, int(sample_rate * duration), endpoint=False)
    wave = (np.sin(2 * np.pi * 320 * t) + np.random.uniform(-1, 1, t.shape)) * np.exp(
        -t * 12
    )
    sound_array = np.column_stack((wave, wave)) * 32767
    return pygame.mixer.Sound(buffer=np.int16(sound_array))
  except:
    return None


def generate_blast_sound():
  if not HAS_NUMPY:
    return None
  try:
    duration = 0.4
    sample_rate = 44100
    t = np.linspace(0, duration, int(sample_rate * duration), endpoint=False)
    wave = (
        np.sin(2 * np.pi * 50 * t) * np.random.uniform(-1, 1, t.shape) * np.exp(-t * 8)
    )
    sound_array = np.column_stack((wave, wave)) * 32767
    return pygame.mixer.Sound(buffer=np.int16(sound_array))
  except:
    return None


def generate_coin_sound():
  if not HAS_NUMPY:
    return None
  try:
    duration = 0.2
    sample_rate = 44100
    t = np.linspace(0, duration, int(sample_rate * duration), endpoint=False)
    wave = (np.sin(2 * np.pi * 987 * t) + np.sin(2 * np.pi * 1318 * t)) * np.exp(-t * 6)
    sound_array = np.column_stack((wave, wave)) * 32767
    return pygame.mixer.Sound(buffer=np.int16(sound_array))
  except:
    return None


def generate_background_music():
  if not HAS_NUMPY:
    return None
  try:
    sample_rate = 44100
    melody_notes = [261.63, 329.63, 392.00, 523.25, 440.00, 349.23, 392.00, 329.63]
    duration_per_note = 0.25
    samples_per_note = int(sample_rate * duration_per_note)
    full_wave = np.array([], dtype=np.float32)

    for _ in range(16):
      for freq in melody_notes:
        t = np.linspace(0, duration_per_note, samples_per_note, endpoint=False)
        wave = 0.07 * np.sin(2 * np.pi * freq * t) * np.exp(-t * 2)
        full_wave = np.concatenate((full_wave, wave))

    stereo_wave = np.column_stack((full_wave, full_wave))
    return pygame.mixer.Sound(buffer=np.int16(stereo_wave * 32767))
  except:
    return None


